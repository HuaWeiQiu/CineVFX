{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-request.schema.json",
  "title": "JobRequest",
  "description": "Idempotent job submission for the Mock vertical slice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "idempotencyKey",
    "effectSpec",
    "inputAssets",
    "protectedSource"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "idempotencyKey": {
      "$ref": "common.schema.json#/$defs/IdempotencyKey"
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effectSpec": {
      "$ref": "effect-spec.schema.json"
    },
    "inputAssets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "digest",
          "purpose"
        ],
        "properties": {
          "assetId": {
            "$ref": "common.schema.json#/$defs/AssetId"
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/Digest"
          },
          "purpose": {
            "$ref": "common.schema.json#/$defs/AssetPurpose"
          }
        }
      }
    },
    "protectedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerStableId",
        "immutable",
        "operationsForbidden"
      ],
      "properties": {
        "layerStableId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Host-stable identifier. Not a filesystem path."
        },
        "documentStableId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "immutable": {
          "type": "boolean",
          "const": true
        },
        "operationsForbidden": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "modify_pixels",
              "move",
              "transform",
              "resize",
              "replace",
              "warp",
              "delete"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "modify_pixels"
              }
            },
            {
              "contains": {
                "const": "move"
              }
            },
            {
              "contains": {
                "const": "transform"
              }
            },
            {
              "contains": {
                "const": "resize"
              }
            },
            {
              "contains": {
                "const": "replace"
              }
            }
          ]
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "normal",
            "low"
          ]
        },
        "dryRun": {
          "type": "boolean"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      }
    }
  }
}
