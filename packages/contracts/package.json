{
  "name": "@cinevfx/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned CineVFX JSON Schemas, OpenAPI, examples, and generated types",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./generated/types.d.ts",
      "import": "./src/index.mjs"
    },
    "./schemas/*": "./schemas/*",
    "./examples/*": "./examples/*",
    "./openapi": "../../openapi/openapi.json"
  },
  "files": [
    "schemas",
    "examples",
    "generated",
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "generate": "node scripts/generate-types.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
